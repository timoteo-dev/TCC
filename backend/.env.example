# URL de conexão com o banco (Postgres do Supabase) para usar psycopg2 + pgvector
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[REF].supabase.co:5432/postgres

# URL do projeto e Chave de Serviço para gerenciar Storage
SUPABASE_URL=https://[REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# Limiar de similaridade de cosseno (padrão 0.36 para ArcFace)
FACE_MATCH_THRESHOLD=0.36
